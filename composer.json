{
    "name": "maksimovic/zend-log",
    "description": "Zend Framework 1 Log package",
    "keywords": ["framework", "zf1", "zend", "log"],
    "homepage": "http://framework.zend.com/",
    "license": "BSD-3-Clause",
    "require": {
        "php": ">=8.1",
        "ext-reflection": "*",
        "maksimovic/zend-exception": "^2.0.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "phpstan/phpstan": "^2.1"
    },
    "autoload": {
        "psr-0": {
            "Zend_Log": "library/"
        }
    },
    "suggest": {
        "ext-dom": "Required for Zend_Log_Formatter_Xml"
    },
    "replace": {
        "zf1/zend-log": "^1.12",
        "zf1s/zend-log": "^1.12",
        "zendframework/zend-log": "*"
    },
    "scripts": {
        "test": "phpunit",
        "test:coverage": "phpunit --coverage-text",
        "phpstan": "phpstan analyse --memory-limit=256M"
    },
    "extra": {
        "branch-alias": {
            "dev-master": "2.x-dev"
        }
    }
}
